# Copy to .env.local and fill in. NEVER commit .env.local.
# NEVER prefix any of these with NEXT_PUBLIC_ — that ships them to the browser.
# See AGENTS.md rule 1.

# Panta API key. Base URL is https://live-api.panta.market/api/v1 (hardcoded in
# src/lib/panta/client.ts — trailing slashes on every route are required).
# Mint one: POST /auth/register/ then POST /account/keys/
# The plaintext secret is shown exactly once.
PANTA_API_KEY=pk_test_replace_me

# Postgres
DATABASE_URL=postgres://user:password@host:5432/pulse

# Solana RPC. The QuickNode token is in the URL path, so the URL IS the credential.
# Mainnet only — Panta has no testnet.
SOLANA_RPC_URL=https://replace-me.solana-mainnet.quiknode.pro/replace-me/

# Used to reserve markets for the live demo so a rehearsal run does not
# collide with DUPLICATE_MARKET.
PULSE_SESSION_NONCE=local
