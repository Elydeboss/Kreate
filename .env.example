# Pulse — environment template. Safe to commit: no real values here.
#
#   cp .env.example .env      and fill it in.
#
# `.env` is the canonical name, not `.env.local`. Next.js loads it automatically
# for dev/build/start, and `npm run db:migrate` loads it through an explicit
# `--env-file-if-exists=.env` flag, because plain Node does not. Use
# `.env.local` only if you want a machine-local override that wins over `.env`
# (Next.js precedence: .env.local > .env).
#
# See the real .env for the reasoning behind each value. This file is the
# inventory; that one is the explanation.
#
# ⚠ NEVER prefix a server secret with NEXT_PUBLIC_ — that inlines it into the
# JS bundle. The one NEXT_PUBLIC_ var below is a URL we are choosing to make
# public, and it is commented out by default for exactly that reason.
# See AGENTS.md rule 1 and Panta ToU §3.

# ── Panta ────────────────────────────────────────────────────────────────────
# Mint one: POST /auth/register/ then POST /account/keys/. Shown once.
# Confirm "canCreateMarkets": true via GET /account/ before anything else.
PANTA_API_KEY=pk_test_replace_me

# ── Postgres ─────────────────────────────────────────────────────────────────
# Local:  postgres://pulse:pulse@localhost:5432/pulse
# Neon:   postgresql://user:pass@ep-xxx.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgres://pulse:pulse@localhost:5432/pulse

# `disable` for a local container; anything else keeps TLS on with
# rejectUnauthorized: false, which is what a managed provider needs.
DATABASE_SSL=disable

# ── Solana RPC, server-side ──────────────────────────────────────────────────
# The token is the last path segment, so this string is the credential.
# Trailing slash required.
SOLANA_RPC_URL=https://replace-me.solana-mainnet.quiknode.pro/replace-me/

# ── Solana RPC, browser ──────────────────────────────────────────────────────
# Intentionally unset by default: uncommenting inlines a QuickNode token into
# the bundle. Only do it if the token is domain-restricted.
# NEXT_PUBLIC_SOLANA_RPC_URL=

# ── Demo ─────────────────────────────────────────────────────────────────────
# Every distinct value mints a different market and costs a real creation fee.
PULSE_SESSION_NONCE=local
